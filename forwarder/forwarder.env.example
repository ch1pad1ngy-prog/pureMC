# Copy this to forwarder.env in the same directory and fill in.

# The public URL of your Railway-hosted bot's webhook endpoint.
# Find it in Railway: Settings -> Networking -> Generate Domain (if you haven't already).
WEBHOOK_URL=https://your-app-name.up.railway.app/events

# Must match WEBHOOK_SECRET set on the bot (Railway Variables tab).
# Generate a random one, e.g.: openssl rand -hex 24
WEBHOOK_SECRET=change-me-to-something-random

# Absolute path to your Minecraft server's log file on THIS machine.
MC_LOG_PATH=/home/minecraft/server/logs/latest.log
